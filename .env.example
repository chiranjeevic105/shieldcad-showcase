# Copy to .env and export before starting the server (or pass through docker compose).
SHIELDCAD_DATA_DIR=./data
SHIELDCAD_HOST=127.0.0.1
SHIELDCAD_PORT=8000
# Local LLM for parts without a template (any OpenAI-compatible server, e.g. vLLM). Leave unset to disable.
# SHIELDCAD_LLM_URL=http://localhost:8001
# SHIELDCAD_LLM_MODEL=your-code-model
# Limits
SHIELDCAD_RATE_GEN_PER_MIN=20
SHIELDCAD_MAX_FAILS=10
SHIELDCAD_SANDBOX_MEM_MB=4096
SHIELDCAD_SANDBOX_TIMEOUT=90
# Set to 0 to disable the network-namespace layer if the host does not allow it
SHIELDCAD_SANDBOX_NETNS=1
